{
  "name": "stride",
  "productName": "Stride",
  "version": "1.0.0",
  "description": "Navegador rápido, seguro y personalizable",
  "main": "main.js",
  "author": "Stride",
  "license": "MIT",
  "scripts": { "start": "electron ." },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.stride.browser.pc",
    "productName": "Stride",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "index.html", "renderer.js", "style.css", "icon.png", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.png", "artifactName": "Stride-Setup.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": { "target": "AppImage", "icon": "build/icon.png", "category": "Network", "artifactName": "Stride.${ext}" }
  }
}
